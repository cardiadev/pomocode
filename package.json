{
  "name": "pomocode",
  "displayName": "PomoCode",
  "description": "A dynamic, aesthetic Pomodoro timer for VS Code with custom themes, Google Sans typography, live streaks, and session history.",
  "version": "0.8.0",
  "publisher": "cardiadev",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/cardiadev/pomocode.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pomodoro",
    "timer",
    "productivity",
    "focus",
    "break"
  ],
  "icon": "assets/icons/pomocode-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pomocode.start",
        "title": "PomoCode: Start Focus Session"
      },
      {
        "command": "pomocode.pause",
        "title": "PomoCode: Pause Timer"
      },
      {
        "command": "pomocode.resume",
        "title": "PomoCode: Resume Timer"
      },
      {
        "command": "pomocode.reset",
        "title": "PomoCode: Reset Timer"
      },
      {
        "command": "pomocode.skip",
        "title": "PomoCode: Skip to Next Session"
      },
      {
        "command": "pomocode.openPanel",
        "title": "PomoCode: Open Panel"
      },
      {
        "command": "pomocode.showQuickMenu",
        "title": "PomoCode: Show Quick Menu"
      }
    ],
    "configuration": {
      "title": "PomoCode",
      "properties": {
        "pomocode.focusDuration": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 180,
          "scope": "window",
          "description": "Length of a focus session, in minutes."
        },
        "pomocode.shortBreakDuration": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "scope": "window",
          "description": "Length of a short break, in minutes."
        },
        "pomocode.longBreakDuration": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "scope": "window",
          "description": "Length of a long break, in minutes."
        },
        "pomocode.sessionsBeforeLongBreak": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 12,
          "scope": "window",
          "description": "Number of focus sessions before a long break is triggered."
        },
        "pomocode.dailyTargetPomodoros": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "scope": "window",
          "description": "Daily target number of completed focus sessions."
        },
        "pomocode.autoStartNextSession": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Automatically start the next session when the current one ends."
        },
        "pomocode.enableNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Show a VS Code notification when a session starts, ends, or transitions."
        },
        "pomocode.enableNativeNotifications": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "macOS only: also show a native system notification, so you see it even when VS Code is in the background."
        },
        "pomocode.nativeNotificationSound": {
          "type": "string",
          "default": "Glass",
          "enum": [
            "None",
            "Basso",
            "Blow",
            "Bottle",
            "Frog",
            "Funk",
            "Glass",
            "Hero",
            "Morse",
            "Ping",
            "Pop",
            "Purr",
            "Sosumi",
            "Submarine",
            "Tink"
          ],
          "scope": "window",
          "description": "macOS only: system sound played with the native notification. Matches the sound names in System Settings > Sound."
        },
        "pomocode.enableSound": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Play a sound in the PomoCode panel when a session ends."
        },
        "pomocode.completionSound": {
          "type": "string",
          "default": "chime",
          "enum": [
            "chime",
            "bell",
            "digital",
            "soft"
          ],
          "enumDescriptions": [
            "Soft single tone (default)",
            "Two-tone bell",
            "Short digital beep",
            "Low, gentle tone"
          ],
          "scope": "window",
          "description": "Tone style played in the panel when a session ends."
        },
        "pomocode.accentColor": {
          "type": "string",
          "default": "#f97316",
          "scope": "window",
          "description": "Primary accent color for buttons and active states."
        },
        "pomocode.focusColor": {
          "type": "string",
          "default": "#f97316",
          "scope": "window",
          "description": "Color used for focus sessions and indicators."
        },
        "pomocode.shortBreakColor": {
          "type": "string",
          "default": "#22c55e",
          "scope": "window",
          "description": "Color used for short break sessions."
        },
        "pomocode.longBreakColor": {
          "type": "string",
          "default": "#38bdf8",
          "scope": "window",
          "description": "Color used for long break sessions."
        },
        "pomocode.fontFamily": {
          "type": "string",
          "default": "Google Sans",
          "scope": "window",
          "description": "Font family used across the PomoCode panel interface."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pomocode",
          "title": "PomoCode",
          "icon": "assets/icons/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "pomocode": [
        {
          "type": "webview",
          "id": "pomocode.panelView",
          "name": "Timer"
        }
      ]
    }
  },
  "scripts": {
    "dev": "bun run scripts/watch.ts",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview-ui/tsconfig.json",
    "lint": "oxlint",
    "check": "bun run lint && bun run typecheck",
    "package": "bun run build && bunx @vscode/vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@vscode/vsce-sign"
  ]
}
